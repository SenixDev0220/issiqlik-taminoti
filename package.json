    "firebase-tools": "15.35.0",
    "firebase-admin": "14.5.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob": "14.0.4",
    "uuid@<11.1.1": "11.1.1",
    "@google-cloud/pubsub": "6.3.2"
  }
}
